{
  "name": "tindascan-rules-tests",
  "private": true,
  "type": "module",
  "description": "Security-rules unit tests for TindaScan (run against the Firestore emulator).",
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-tindascan --config ../../firebase.json \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.0.0"
  }
}
